/var/log/arena_x/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 0640 www-data www-data
    sharedscripts
    postrotate
        systemctl reload arena_x.service 2>/dev/null || true
        systemctl reload nginx 2>/dev/null || true
    endscript
}

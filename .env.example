# ==============================================================================
# ARENA X 2026 // PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. On your production VPS, copy this file to: /var/www/arena_x/.env
# 2. Generate secure random secrets using: python3 deploy/generate_production_keys.py
#    or: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Fill in your actual domain, email credentials, and generated keys.
# 4. Restrict permissions: chmod 640 /var/www/arena_x/.env && chown root:www-data /var/www/arena_x/.env
# 5. NEVER commit .env into git or include it in deployment archives!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' for live deployment, 'development' for local staging.
# In production, Flask debug mode is strictly forbidden and secure cookies are enforced.
FLASK_ENV=production
FLASK_DEBUG=false

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS (MANDATORY — GENERATE UNIQUE KEYS BEFORE DEPLOYMENT)
# ------------------------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<GENERATE_NEW_RANDOM_SECRET>

# Strong tournament organizer passkey for admin dashboard access (/admin).
# Never use predictable words.
# Generate: python3 -c "import secrets; print('AX2026_' + secrets.token_urlsafe(24))"
ARENA_ADMIN_KEY=<GENERATE_NEW_RANDOM_ADMIN_KEY>

# Database master encryption key for field-level Fernet PII encryption at rest.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
DB_PASSWORD=<GENERATE_NEW_RANDOM_DB_KEY>

# Optional custom cryptographic salt for PBKDF2 key derivation.
# Leave blank to use the standard application salt, or set a random hex string for a fresh installation.
# DB_KDF_SALT=

# ------------------------------------------------------------------------------
# 3. REVERSE PROXY & CLOUDFLARE CONFIGURATION
# ------------------------------------------------------------------------------
# Enable ProxyFix to correctly restore visitor IPs and HTTPS scheme behind Nginx.
BEHIND_PROXY=true
PROXIES_COUNT=1

# Restore real visitor IP addresses from Cloudflare Edge headers (CF-Connecting-IP).
# Set to 'true' if using Cloudflare DNS/CDN proxy in front of your Hostinger VPS.
TRUST_CLOUDFLARE_IP=true

# Trusted upstream proxies (IP of local Nginx reverse proxy).
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 4. SESSION & COOKIE SECURITY
# ------------------------------------------------------------------------------
# Strictly enforce HTTPS-only cookies in production.
# Must be 'true' in production (HTTPS). Set 'false' only for local HTTP testing.
SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 5. STRICT CORS ALLOWLIST
# ------------------------------------------------------------------------------
# Comma-separated list of fully-qualified origins permitted to query API endpoints.
# Wildcard '*' is strictly rejected. Replace with your registered production domains.
ALLOWED_ORIGINS=https://YOUR-DOMAIN.com,https://www.YOUR-DOMAIN.com

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING (REDIS)
# ------------------------------------------------------------------------------
# Redis connection URL for cross-worker rate limiting (login, registration, scans).
# Redis should listen exclusively on 127.0.0.1 (never expose port 6379 publicly).
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL DISPATCH (GOOGLE WORKSPACE / GMAIL)
# ------------------------------------------------------------------------------
# SMTP credentials for sending automated QR accreditation passes & confirmation receipts.
# For Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (Requires 2-Step Verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<YOUR_EMAIL>
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
SENDER_EMAIL=<YOUR_EMAIL>
REPLY_TO_EMAIL=<YOUR_EMAIL>

# ------------------------------------------------------------------------------
# 8. OPTIONAL: CLOUDFLARE TURNSTILE BOT PROTECTION
# ------------------------------------------------------------------------------
# Optional Cloudflare Turnstile keys. If left empty, internal visual CAPTCHA is used.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

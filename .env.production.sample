# ==============================================================================
# ARENA X 2026 // Production Secrets Template (.env.production.sample)
#
# INSTRUCTIONS FOR HOSTINGER KVM 1 DEPLOYMENT:
# 1. Copy this file to /var/www/arena_x/.env on your Hostinger VPS:
#    cp .env.production.sample /var/www/arena_x/.env
# 2. Generate cryptographically secure keys using:
#    python3 deploy/generate_production_keys.py
# 3. Replace placeholder values below with your generated secrets, domain, and email.
# 4. Restrict file permissions immediately:
#    chmod 600 /var/www/arena_x/.env && chown www-data:www-data /var/www/arena_x/.env
# 5. NEVER commit your live .env into Git or include it in deployment archives!
# ==============================================================================

FLASK_ENV=production
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=true
SECRET_KEY=<GENERATE_NEW_RANDOM_SECRET>
ARENA_ADMIN_KEY=<GENERATE_NEW_RANDOM_ADMIN_KEY>
DB_PASSWORD=<GENERATE_NEW_RANDOM_DB_KEY>
BEHIND_PROXY=true
PROXIES_COUNT=1
TRUST_CLOUDFLARE_IP=true
TRUSTED_PROXIES=127.0.0.1,::1
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_ORIGINS=https://YOUR-DOMAIN.com,https://www.YOUR-DOMAIN.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<YOUR_EMAIL>
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
SENDER_EMAIL=<YOUR_EMAIL>
REPLY_TO_EMAIL=<YOUR_EMAIL>
